# Copy this file to .env and paste your Groq API key (get one free at https://console.groq.com)
GROQ_API_KEY=

# Optional: URL of the local background-removal sidecar (services/bg-removal).
# Leave unset to skip cutouts entirely — the app still works with original photos.
# BG_REMOVAL_URL=http://127.0.0.1:7000

# Supabase Postgres (garment records). From the dashboard: Project Settings → API.
# SUPABASE_SERVICE_KEY is the service_role key — SERVER-ONLY, never ships to the
# app bundle (db.ts runs only inside API routes). Keep it out of git.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
