# Copy this file to .env and fill in the values.

# Groq API key — powers item analysis and outfit suggestions.
# Get one free at https://console.groq.com
GROQ_API_KEY=

# URL of the background-removal sidecar (services/bg-removal). Leave unset to
# skip cutouts entirely — the app still works, garments just keep their original
# photo. Locally this is the sidecar `npm start` launches; in production it must
# be a PUBLICLY reachable host, because the deployed server cannot dial into your
# laptop. See services/bg-removal/README.md for deploying it.
# BG_REMOVAL_URL=http://127.0.0.1:7000

# Shared secret for the hosted sidecar. Required in production (a public /cutout
# with no token lets anyone burn your free tier's CPU); leave unset locally,
# where the sidecar is bound to 127.0.0.1. Must match BG_REMOVAL_TOKEN on the
# sidecar itself.
# BG_REMOVAL_TOKEN=

# --- Neon --------------------------------------------------------------------
# Server-only (lib/db.ts) — never give this an EXPO_PUBLIC_ prefix. Unlike
# Supabase's old anon key this is a real database credential, so it must never
# reach the client bundle; every table is scoped to a user in application code
# instead of a DB-enforced RLS policy (see lib/server/auth.ts).
# From the Neon dashboard: Connect → Connection string → Show password.
DATABASE_URL=postgresql://user:password@YOUR-PROJECT.neon.tech/neondb?sslmode=require

# Signs the app's own JWTs (lib/server/auth.ts). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
