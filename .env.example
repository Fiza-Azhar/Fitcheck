# Copy this file to .env and fill in the values.

# Groq API key — powers item analysis and outfit suggestions.
# Get one free at https://console.groq.com
GROQ_API_KEY=

# URL of the background-removal sidecar (services/bg-removal). Leave unset to
# skip cutouts entirely — the app still works, garments just keep their original
# photo. Locally this is the sidecar `npm start` launches; in production it must
# be a PUBLICLY reachable host, because the deployed server cannot dial into your
# laptop. See services/bg-removal/README.md for deploying it.
# BG_REMOVAL_URL=http://127.0.0.1:7000

# Shared secret for the hosted sidecar. Required in production (a public /cutout
# with no token lets anyone burn your free tier's CPU); leave unset locally,
# where the sidecar is bound to 127.0.0.1. Must match BG_REMOVAL_TOKEN on the
# sidecar itself.
# BG_REMOVAL_TOKEN=

# --- Supabase ---------------------------------------------------------------
# From the dashboard: Project Settings → API.

# Client-side (lib/supabase.ts). The EXPO_PUBLIC_ prefix inlines these into the
# app bundle — safe, because Row-Level Security (not key secrecy) protects data.
# Use the ANON (publishable) key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Also exposed to server routes.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Server-only. The service_role key bypasses RLS — never give it an EXPO_PUBLIC_
# prefix and never ship it to the client. Optional now that garment CRUD runs on
# the RLS-scoped client; keep only if a future server route needs privileged access.
# SUPABASE_SERVICE_KEY=your-service-role-key
